---
// Logomark-style homepage card (branding projects): a background color card
// with the logo layered on top as its own element, so a hover micro-
// animation can move/scale each independently. Every card is the same two
// dimensions, transposed by orientation — see SHORT/LONG below.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, cover, bg, bg2 } = entry.data;

// bg2 present: hover transitions the actual background color to it.
// bg2 absent: fall back to darkening the existing bg via a filter.
const bgStyle = [
	bg && `--bg: ${bg};`,
	bg2 ? `--bg-hover: ${bg2};` : bg && `--hover-filter: brightness(0.85);`,
]
	.filter(Boolean)
	.join(' ');

// Every card is the exact same two dimensions, just transposed: landscape
// logos get the long side as width, portrait logos get it as height. Sized
// with clamp() (viewport-relative, not a fixed px) so it scales with the
// page instead of being a hard-coded size that's only right at one width.
const SHORT = 'clamp(11rem, 20vw, 17rem)';
const LONG = 'clamp(13.2rem, 24vw, 20.4rem)';
const RATIO = 20.4 / 17; // LONG:SHORT at their max, used for aspect-ratio
const isLandscape = cover ? cover.width >= cover.height : true;
const widthValue = isLandscape ? LONG : SHORT;
const aspectRatio = isLandscape ? RATIO : 1 / RATIO;
const thumbStyle = `width: ${widthValue}; aspect-ratio: ${aspectRatio.toFixed(4)};`;
---

<a class="card" href={`/work/${entry.id}/`}>
	<div class="thumb squircle" data-squircle-radius="40" style={thumbStyle}>
		<div class="bg" style={bgStyle || undefined}></div>
		{cover && <Image class="logo" src={cover} alt={title} width={400} />}
	</div>
	<span class="title">{title}</span>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		color: var(--ink);
	}

	.thumb {
		position: relative;
		max-width: 100%;
		overflow: hidden;
	}

	.bg {
		position: absolute;
		inset: 0;
		z-index: 0;
		background-color: var(--bg, transparent);
		transition: background-color 0s ease, filter 0s ease;
	}

	.card:hover .bg {
		background-color: var(--bg-hover, var(--bg, transparent));
		filter: var(--hover-filter, none);
	}

	.card :global(.logo) {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: 100%;
		padding: 15%;
		box-sizing: border-box;
		object-fit: contain;
		transition: transform 0.25s ease;
	}

	.card:hover :global(.logo) {
		/* transform: scale(1.2); */
	}

	.title {
		font-weight: 200;
		font-size: 1.25rem;
		text-align: center;
		line-height: 1.3;
	}
</style>
