---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
	entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, cover, cardType } = entry.data;
---

<a class="card" data-type={cardType} href={`/work/${entry.id}/`}>
	<div
		class:list={['thumb', { squircle: cardType === 'media' }]}
		data-squircle-radius={cardType === 'media' ? 56 : undefined}
	>
		{cover && <Image src={cover} alt={title} width={640} />}
	</div>
	<span class="title">{title}</span>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		color: var(--ink);
	}

	/* Cards get their own richer hover (image zoom) instead of the
	   site-wide link fade — dimming a portfolio thumbnail feels backwards. */
	.card:hover {
		opacity: 1;
	}

	.thumb {
		width: 100%;
		aspect-ratio: 6 / 5;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.card[data-type='media'] .thumb {
		border-radius: 3.5rem;
		overflow: hidden;
		background: #000;
	}

	.card[data-type='media'] .thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.card[data-type='media']:hover .thumb :global(img) {
		transform: scale(1.05);
	}

	.card[data-type='logomark'] .thumb :global(img) {
		width: 70%;
		height: 70%;
		object-fit: contain;
		transition: transform 0.25s ease;
	}

	.card[data-type='logomark']:hover .thumb :global(img) {
		transform: scale(1.06);
	}

	.title {
		font-weight: 200;
		font-size: 1.25rem;
		text-align: center;
		line-height: 1.3;
	}
</style>
