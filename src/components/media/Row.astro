---
interface Props {
	items: string[];
}

const { items } = Astro.props;
---

<div class="row">
	{items.map((src) => <img class="squircle" data-squircle-radius="16" src={src} alt="" loading="lazy" />)}
</div>

<style>
	.row {
		display: flex;
		gap: 2rem;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		width: 100%;
		margin: 0;
	}
	.row img {
		width: 26%;
		min-width: 140px;
		--squircle-r: 16px;
		border-radius: 1rem;
	}

	/* When there are exactly 3 items, give the middle one more presence. */
	.row img:nth-child(2):nth-last-child(2) {
		width: 28%;
		min-width: 170px;
	}

	@media (max-width: 640px) {
		.row {
			/* flex-direction: column; */
			gap: 0.5rem;
		}
		.row img {
			width: 30%;
			min-width: unset;
			--squircle-r: 10px;
			border-radius: 0.6rem;
		}
		.row img:nth-child(2):nth-last-child(2) {
			width: 33%;
			min-width: unset;
			/* width: 60%; */
		}
	}
</style>
