<style>
	main {
		max-width: 40rem;
		margin: 0 auto;
		padding: 2rem 1.5rem 5rem;
	}

	.home {
		display: inline-block;
		font-weight: 200;
		text-decoration: none;
		color: var(--ink);
		margin: 1rem 0;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 200;
		margin: 2rem 0 1.5rem;
	}

	p {
		font-size: 1.15rem;
		line-height: 1.6;
		margin: 0 0 2.5rem;
	}

	.links {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: 1.15rem;
	}

	.links a {
		color: var(--ink);
		font-weight: 200;
	}

	.back {
		margin-top: 4rem;
	}
</style>
