---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Omer Alon">
	<main>
		<a class="home" href="/">← Home</a>

		<h1>About</h1>

		<p>
			{/* TODO: replace with real bio text */}
			Omer Alon is a designer working across branding, illustration, and interactive
			3D — based in Israel, graduate of the Bezalel Academy of Art and Design in Jerusalem.
		</p>

		<div class="links">
			<a href="/CV.pdf" target="_blank">CV →</a>
			<a href="mailto:omeralon3@gmail.com">omeralon3@gmail.com</a>
		</div>

		<a class="home back" href="/">← Home</a>
	</main>
