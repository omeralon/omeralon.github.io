---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const entries = await getCollection('work');
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, credits } = entry.data;
---

<Layout title={`${title} — Omer Alon`}>
	<main>
		<a class="home" href="/">← Home</a>

		<header>
			<h1>{title}</h1>
			<p class="summary">{summary}</p>
		</header>

		<div class="content">
			<Content />
		</div>

		{
			credits.length > 0 && (
				<footer>
					<ul>
						{credits.map((line) => (
							<li>{line}</li>
						))}
					</ul>
				</footer>
			)
		}

		<a class="home" href="/">← Home</a>
	</main>
</Layout>

<style is:global>
	.content h2 {
		font-size: 1.4rem;
		font-weight: 200;
		text-align: center;
		max-width: 34rem;
		margin: 1.75rem auto 0.5rem;
	}

	.content p {
		text-align: center;
		max-width: 34rem;
		line-height: 1.6;
		margin: 0.5rem auto;
	}

	.content a {
		color: var(--ink);
	}
</style>

<style>
	main {
		max-width: 56rem;
		margin: 0 auto;
		padding: 2rem 1.5rem 5rem;
	}

	.home {
		display: inline-block;
		font-weight: 200;
		text-decoration: none;
		color: var(--ink);
		margin: 1rem 0;
	}

	header {
		margin: 2rem 0;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 200;
		margin: 0 0 0.75rem;
	}

	.summary {
		font-size: 1.15rem;
		max-width: 40rem;
		line-height: 1.5;
	}

	.content {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	footer {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 2px solid rgba(0, 0, 0, 0.1);
		font-size: 0.9rem;
	}

	footer ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		justify-content: center;
	}

	@media (max-width: 640px) {
		h1 {
			font-size: 1.9rem;
		}
	}
</style>
